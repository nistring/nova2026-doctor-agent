# Backend for dev scripts: claude (Anthropic API; recommended), nova (competition API with the dev key; run in your
# own terminal), or openai (personal key)
DEV_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-role Claude model overrides. Defaults: luna (Doctor) = claude-haiku-5-5, terra (patient/examiner) =
# claude-sonnet-5-5, sol (generation/grading) = claude-opus-5-5
# CLAUDE_LUNA_MODEL=claude-haiku-5-5
# CLAUDE_TERRA_MODEL=claude-sonnet-5-5
# CLAUDE_SOL_MODEL=claude-opus-5-5
# Roles sent through headless Claude Code (`claude -p`, billed to the logged-in Claude plan, not the API key; ~10 s per
# call; shares the plan's usage limits with interactive Claude Code sessions). Empty = all roles use the API.
# CLAUDE_CODE_ROLES=terra,sol
NOVA_API_BASE=https://nova.snubhai.org
# NOVA_DEV_KEY=...   (read only by scripts you run yourself; Claude Code never loads it)
